# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
NODE_ENV=development

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3001
HOST=localhost

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MongoDB (primary)
MONGODB_URI=mongodb://localhost:27017/rack_calculator
MONGODB_DB_NAME=rack_calculator

# SQLite (legacy - for migration only)
# DB_PATH=./data/rack_calculator.db

# ==========================================
# JWT SECURITY CONFIGURATION
# ==========================================
# IMPORTANT: Change these in production!
# Use at least 32 characters for secrets
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# CORS CONFIGURATION
# ==========================================
CORS_ORIGIN=http://localhost:3000
# For multiple origins: CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# ==========================================
# RATE LIMITING CONFIGURATION
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==========================================
# EMAIL CONFIGURATION (for verification)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@rack-calculator.com
# EMAIL_FROM="Your App Name" <noreply@example.com>

# ==========================================
# CLEANUP JOBS CONFIGURATION
# ==========================================
# Audit Log Cleanup
AUDIT_CLEANUP_ENABLED=true
AUDIT_CLEANUP_SCHEDULE=0 2 * * 0
AUDIT_CLEANUP_DAYS=90
AUDIT_CLEANUP_RUN_ON_START=false

# Token Cleanup
TOKEN_CLEANUP_ENABLED=true
TOKEN_CLEANUP_SCHEDULE=0 3 * * 0
TOKEN_CLEANUP_DAYS=30

# Deleted Records Cleanup (soft deleted)
DELETED_CLEANUP_ENABLED=true
DELETED_CLEANUP_SCHEDULE=0 4 * * 0
DELETED_CLEANUP_DAYS=30

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
LOG_LEVEL=debug
# LOG_LEVEL=error | warn | info | debug | trace

# ==========================================
# SWAGGER API DOCS
# ==========================================
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs
